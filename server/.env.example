# ─── Car Parking Management System — Backend Environment Variables ───────────
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# MongoDB connection string
# Local: mongodb://localhost:27017/carparking
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/carparking?retryWrites=true&w=majority
MONGO_URI=

# JWT secret — use a long, random, hard-to-guess string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# URL of the frontend (used for CORS)
# Local: http://localhost:3000
# Production: https://your-frontend-domain.com
CLIENT_URL=

# Server port (default: 5000)
PORT=5000

# Environment: development | production
NODE_ENV=development
